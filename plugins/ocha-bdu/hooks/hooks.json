{
  "description": "Notes at session start: a one-time offer to switch on automatic updates for the OCHA BDU skills, which the Claude desktop app leaves off; once per update, what changed, in plain words; and a quiet check that this computer is not stuck on an old version. Each is silent once dealt with. See hooks/README.md.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/autoupdate${FORCE_AUTOUPDATE_PLUGINS}${env:FORCE_AUTOUPDATE_PLUGINS}.md\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/news/after-${OCHA_BDU_NEWS_SEEN}${env:OCHA_BDU_NEWS_SEEN}.md\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/versioncheck.md\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/plugin.json\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
