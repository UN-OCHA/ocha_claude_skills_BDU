// Shared helpers for OCHA InDesign scripts.
// Every script that changes a document writes a JSON log of each change (before -> after),
// so a reviewer can see exactly what moved. The log path is a script argument.

function ser(v) {
    function q(s) {
        return '"' + String(s).replace(/\\/g, "\\\\").replace(/"/g, '\\"')
            .replace(/\r/g, "\\r").replace(/\n/g, "\\n").replace(/\t/g, "\\t")
            .replace(/[\u0000-\u001f]/g, " ") + '"';
    }
    if (v === null || v === undefined) return "null";
    if (typeof v === "number" || typeof v === "boolean") return String(v);
    if (typeof v === "string") return q(v);
    if (v instanceof Array) { var a = []; for (var i = 0; i < v.length; i++) a.push(ser(v[i])); return "[" + a.join(",") + "]"; }
    var p = []; for (var k in v) if (v.hasOwnProperty(k)) p.push(q(k) + ":" + ser(v[k])); return "{" + p.join(",") + "}";
}
function writeText(path, s) { var f = File(path); f.encoding = "UTF-8"; f.open("w"); f.write(s); f.close(); }
function safe(f, d) { try { return f(); } catch (e) { return d === undefined ? null : d; } }

// Open the ORIGINAL file (a .indt otherwise opens as an untitled copy and could not be saved back).
function openOriginal(path, showWindow) {
    app.scriptPreferences.userInteractionLevel = UserInteractionLevels.NEVER_INTERACT;
    return app.open(File(path), showWindow !== false, OpenOptions.OPEN_ORIGINAL);
}
// Save in place, keeping a template a template.
function saveInPlace(doc, path) {
    var isTemplate = /\.indt$/i.test(path);
    doc.save(File(path), isTemplate);
}
function exportPreview(doc, pdfPath) {
    var preset = app.pdfExportPresets.itemByName("[Smallest File Size]");
    app.pdfExportPreferences.pageRange = PageRange.ALL_PAGES;
    doc.exportFile(ExportFormat.PDF_TYPE, File(pdfPath), false, preset);
}
function pageOf(textObj) {
    return safe(function () {
        var tf = textObj.parentTextFrames[0];
        if (!tf) return "overset";
        var pg = tf.parentPage;
        if (!pg) return "pasteboard";
        return (pg.parent.constructor.name === "MasterSpread") ? ("master " + pg.parent.name) : pg.name;
    }, "?");
}
